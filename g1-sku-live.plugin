#!name=G1 SKU Live
#!desc=Google One（iOS）SKU 采集与探测。被动收集 one.google.com 响应里全部 g1.* 与 com.google.gemini.* 编号，本地报告页按「疑似优惠池」分栏列出，支持候选编号探测（判断服务端是否真的下发过）与改写配置。数据不出设备。
#!system=ios
#!author=正方形
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
# 打死 UDP 443，逼 QUIC 回落 TCP，否则看不到 HTTP 层
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/guyue211/g1-sku-live@main/g1-sku-live.js, requires-body=true, max-size=0, timeout=60, tag=G1 SKU Live
http-request ^https:\/\/one\.google\.com\/g1-sku-live-report script-path=https://cdn.jsdelivr.net/gh/guyue211/g1-sku-live@main/g1-sku-live-report.js, requires-body=true, max-size=0, timeout=60, tag=G1 SKU Live Report

[MITM]
hostname = %APPEND% one.google.com
