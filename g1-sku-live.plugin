#!name=G1 SKU Live
#!desc=Google One（iOS）SKU 采集、解析与探测。被动收集 one.google.com 响应里全部 g1.* 与 com.google.* 编号并抓取上下文价格；本地报告页把编号解析成命名空间/档位/周期/类型/折扣率，判定能否作改写目标；支持按档位生成候选组合并只列出服务端真正下发过的编号。数据不出设备。
#!system=ios
#!author=正方形
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-request ^https:\/\/one\.google\.com\/g1-sku-live-report tag=G1SKULiveReport, script-path=https://cdn.jsdelivr.net/gh/guyue211/g1-sku-live@e963d48/g1-sku-live.js, timeout=60
http-response ^https:\/\/one\.google\.com\/ tag=G1SKULive, script-path=https://cdn.jsdelivr.net/gh/guyue211/g1-sku-live@e963d48/g1-sku-live.js, requires-body=true, max-size=0, timeout=60

[MITM]
hostname = one.google.com
