#!name=G1 ACQ · 1元开Pro (v7.11 20TB入口)
#!desc=改编自 crhywun/g1-acq v7.11.0（PR #8 实测版）。将 one.google.com/ai? 响应中的 g1.ios.20tb.m.v2 精确改写为 com.google.gemini.2tb.ai.m.3month_ip_99p（前三月约 1 元/月）。启用后点 Google One Ultra 5x (20TB) 入口触发，实际到手权益为 Pro。开启时请关闭「土区20TB」与「Ultra 3个月75p」。
#!system=ios
#!author=crhywun / duwqijlk / guyue211
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://gh-proxy.com/https://raw.githubusercontent.com/guyue211/g1-sku-live/main/g1-acq/g1-acq-pro-1yuan-v711.js?v=1, requires-body=true, timeout=60, tag=G1AcqPro1YuanV711

[MITM]
hostname=one.google.com
