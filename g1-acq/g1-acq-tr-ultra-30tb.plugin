[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://gh-proxy.com/https://raw.githubusercontent.com/guyue211/g1-sku-live/main/g1-acq/g1-acq-tr-ultra-30tb.js?v=1, requires-body=true, timeout=60, tag=G1AcqTrUltra30TB

