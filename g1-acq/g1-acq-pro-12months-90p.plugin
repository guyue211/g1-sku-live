#!name=G1 ACQ · Pro 12个月90p
#!desc=改编自 crhywun/g1-acq v7.12.0 模板「2TB / Pro · 12个月 90p（pro-12months-90p）」。将 one.google.com/ai? 响应中的 Pro 前缀 g1.ios.2tb.* 改写为 g1.2tb.ai.12months_ip_90p（90p=减免90%、约一折）。启用后进入 Google One 2TB/Pro 方案页，实际金额与周期以 App Store 收银台为准。可与土区 20TB/30TB、Ultra 75p 同时启用；与「1元开Pro」互斥。
#!system=ios
#!author=crhywun / guyue211
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://gh-proxy.com/https://raw.githubusercontent.com/guyue211/g1-sku-live/main/g1-acq/g1-acq-pro-12months-90p.js?v=1, requires-body=true, timeout=60, tag=G1AcqPro12m90p

[MITM]
hostname=one.google.com
