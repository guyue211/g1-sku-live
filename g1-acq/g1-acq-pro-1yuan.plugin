#!name=G1 ACQ · 1元开Pro
#!desc=改编自 crhywun/g1-acq v7.12.0 模板「1 元开 Pro（pro-1yuan）」。将 one.google.com/ai? 响应中的 Pro 前缀 g1.ios.2tb.* 改写为 com.google.gemini.2tb.ai.m.3month_ip_99p（前三月约 1 元/月）。启用后进入 Google One 2TB/Pro 方案页，实际金额与周期以 App Store 收银台为准。可与土区 20TB/30TB、Ultra 75p 同时启用；与「Pro 12个月90p」互斥。
#!system=ios
#!author=crhywun / guyue211
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://gh-proxy.com/https://raw.githubusercontent.com/guyue211/g1-sku-live/main/g1-acq/g1-acq-pro-1yuan.js?v=1, requires-body=true, timeout=60, tag=G1AcqPro1Yuan

[MITM]
hostname=one.google.com
