#!name=G1 ACQ · Ultra 3个月75p
#!desc=改编自 crhywun/g1-acq v7.12.0 模板「Ultra 20TB / 30TB · 三个月 75p（ultra-75p）」。将 one.google.com/ai? 响应中的 g1.ios.20tb.m.v2 改写为 g1.20tb.3months_ip_75p.acq，将 g1.ios.30tb.ai.pro.m 改写为 g1.ai.ultra.3months_ip_75p.acq（75p=减免75%、实付25%）。可与「1元开Pro / Pro 12个月90p」同时启用；与「土区20TB / 土区30TB」互斥。
#!system=ios
#!author=crhywun / guyue211
#!homepage=https://github.com/guyue211/g1-sku-live

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://gh-proxy.com/https://raw.githubusercontent.com/guyue211/g1-sku-live/main/g1-acq/g1-acq-ultra-75p.js?v=1, requires-body=true, timeout=60, tag=G1AcqUltra75p

